# ============================================================================
# Committed, non-secret defaults for the Docker stack.
# Every service loads this first, then `.env.docker` (gitignored) on top, so
# put your real keys in `.env.docker` — never in here.
# ============================================================================

# ---- Auth -----------------------------------------------------------------
# Dev-only secret. Replace it in `.env.docker` before exposing this anywhere:
#   openssl rand -base64 32
AUTH_SECRET="docker-local-development-secret-change-me"

# Better Auth validates that these are non-empty at boot. The placeholders keep
# the app running; Discord sign-in only works with real credentials.
AUTH_DISCORD_ID="placeholder-discord-client-id"
AUTH_DISCORD_SECRET="placeholder-discord-client-secret"

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="dummy-key"

# ---- AI / scanning --------------------------------------------------------
# The scan backend falls back to mocked responses whenever GEMINI_API_KEY is
# empty, so the stack is usable end-to-end without any provider account.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
MOCK_GEMINI="true"

# Clara'''s LLM lives in the ai-sidecar and needs a real Google/Gemini key.
# Mock mode lets the whole chat flow run end-to-end without one, which is what
# makes /scan testable out of the box. Set a real GEMINI_API_KEY and flip this
# to false for genuine answers.
ENABLE_MOCK_MODE="true"

# ---- Pipeline tuning ------------------------------------------------------
OCR_CONFIDENCE_THRESHOLD="0.7"
PIPELINE_MAX_RETRIES="2"
