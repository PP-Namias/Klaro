# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# The database URL is used to connect to your Supabase database.
POSTGRES_URL="postgres://postgres.[USERNAME]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel"


# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Preconfigured Discord OAuth provider, works out-of-the-box
# @see https://www.better-auth.com/docs/authentication/discord
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''

# Google OAuth provider (optional)
# @see https://console.cloud.google.com/
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''

# Cloudinary configuration (add your secrets to .env)

# LLM Configuration (for plain-language medical explanations)
# Supports: openai, claude, gemini
LLM_PROVIDER='gemini'
LLM_API_KEY=''
LLM_MODEL='' # Leave blank for provider defaults

# OpenAI Configuration (if using OpenAI as LLM provider)
# OPENAI_API_KEY='' # Use LLM_API_KEY instead
# OPENAI_MODEL='gpt-4-turbo'

# Claude Configuration (if using Claude as LLM provider)
# CLAUDE_API_KEY='' # Use LLM_API_KEY instead
# CLAUDE_MODEL='claude-3-sonnet-20240229'

# Google Gemini Configuration (if using Gemini as LLM provider)
# GEMINI_API_KEY='' # Use LLM_API_KEY instead
# GEMINI_MODEL='gemini-1.5-pro'

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Cal.com configuration
CAL_COM_API_KEY=""
CAL_COM_BASE_URL="https://api.cal.com"
CAL_COM_WEBHOOK_SECRET="" # Shared secret for webhook signature validation

# OCR / Google Vision (optional cloud fallback)
GOOGLE_VISION_API_KEY=""
# Optional override for OCR confidence threshold (0-1). Defaults to 0.7
OCR_CONFIDENCE_THRESHOLD=""
