# ============================================================================
# Klaro Environment Variables Template
# ============================================================================
# Copy this file to `.env` in the project root and populate all values.
# NEVER commit `.env` — it contains secrets and is gitignored.
# The values below reflect what the current codebase actually reads.
# ============================================================================

# ============== DATABASE (REQUIRED) ==============
# Used by Drizzle and server routes
POSTGRES_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]/neondb?sslmode=require&channel_binding=require"

# ============== AUTHENTICATION (REQUIRED FOR PRODUCTION) ==============
# Generate locally: openssl rand -base64 32
AUTH_SECRET="[GENERATE_LOCALLY]"

# Neon Auth (optional if you migrate the app to Neon Auth UI)
NEXT_PUBLIC_NEON_AUTH_URL="https://[PROJECT].neonauth.[REGION].aws.neon.tech/[DATABASE]/auth"

# Discord OAuth
AUTH_DISCORD_ID="[FROM_DISCORD_DEVELOPER_PORTAL]"
AUTH_DISCORD_SECRET="[FROM_DISCORD_DEVELOPER_PORTAL]"

# Google OAuth (optional)
AUTH_GOOGLE_ID="[OPTIONAL_FROM_GOOGLE_CLOUD_CONSOLE]"
AUTH_GOOGLE_SECRET="[OPTIONAL_FROM_GOOGLE_CLOUD_CONSOLE]"

# ============== SUPABASE (RECOMMENDED / FRONTEND INTEGRATION) ==============
# The Next.js app has safe defaults for local dev, but real Supabase values
# are needed for a working production deployment.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[KEY]"

# Optional service-role key for privileged server actions.
# Only add this if you actually use server-side Supabase admin operations.
SUPABASE_SERVICE_ROLE_KEY="[OPTIONAL_SB_SECRET_KEY]"

# ============== STORAGE – CLOUDINARY (REQUIRED FOR UPLOADS / SCANS) ==============
CLOUDINARY_CLOUD_NAME="[FROM_CLOUDINARY_DASHBOARD]"
CLOUDINARY_API_KEY="[FROM_CLOUDINARY_API_KEYS]"
CLOUDINARY_API_SECRET="[FROM_CLOUDINARY_API_KEYS]"
CLOUDINARY_UPLOAD_PRESET="klaro_uploads"

# ============== LLM / AI (REQUIRED FOR MEDICAL EXPLANATIONS) ==============
# Supported values: gemini, openai, claude
LLM_PROVIDER="gemini"
LLM_API_KEY="[GET_FROM_PROVIDER_CONSOLE]"
LLM_MODEL=""

# ============== AI SIDECAR (LANGCHAIN/LANGGRAPH RAG MICROSERVICE) ==============
# URL of the @klaro/ai-sidecar service (port 3002 by default).
# When set, chat.sendMessage routes through the LangChain/LangGraph RAG engine
# and falls back to the direct LLM API when the sidecar is unreachable.
AI_SIDECAR_URL="http://localhost:3002"

# ============== CHAT (MOCK / RETRY TUNING) ==============
# Set true to return simulated answers without any API key
# ENABLE_MOCK_MODE="false"

# ============== OCR / DOCUMENT PIPELINE (OPTIONAL) ==============
# OCR confidence threshold (0.0-1.0) — documents below this are rejected
OCR_CONFIDENCE_THRESHOLD="0.7"
# Max retries with enhanced preprocessing before rejection
OCR_MAX_RETRIES="2"
# Enable image preprocessing (deskew, denoise, binarize) before OCR
OCR_ENABLE_PREPROCESSING="true"
# Enable cloud OCR fallback when local confidence is low
OCR_ENABLE_CLOUD_FALLBACK="false"

# ============== GEMINI AI (REQUIRED FOR AI ANALYSIS) ==============
# Gemini API key — used for document extraction and simplification
GEMINI_API_KEY="[GET_FROM_GOOGLE_AI_STUDIO]"
# Gemini model name
GEMINI_MODEL="gemini-2.0-flash"
# Enable Gemini Vision direct image analysis
GEMINI_ENABLE_VISION="true"
# Minimum confidence for Gemini extraction results (0.0-1.0)
GEMINI_CONFIDENCE_THRESHOLD="0.6"
# Max retries for Gemini API calls
GEMINI_MAX_RETRIES="3"
# Gemini API timeout in milliseconds
GEMINI_TIMEOUT="60000"
# URL for external Gemini scan backend (optional, defaults to localhost:3001)
GEMINI_SCAN_API_URL="http://localhost:3001"

# ============== PIPELINE (GLOBAL) ==============
# Max retries for the full pipeline (OCR + Gemini)
PIPELINE_MAX_RETRIES="2"

# ============== SCHEDULING – CAL.COM (REQUIRED FOR BOOKINGS) ==============
CAL_COM_API_KEY="[FROM_CAL_COM_DASHBOARD]"
CAL_COM_BASE_URL="https://api.cal.com"
CAL_COM_WEBHOOK_SECRET="[GENERATE_LOCALLY]"
CAL_COM_EVENT_URL="https://cal.com/klaro/1-hour-session-with-clara"

# ============== OCR / DOCUMENT PARSING (OPTIONAL) ==============
GOOGLE_VISION_API_KEY="[OPTIONAL_FROM_GOOGLE_CLOUD]"
OCR_CONFIDENCE_THRESHOLD="0.7"
# Writable location for tesseract.js language data (read-only FS on serverless).
TESSERACT_CACHE_PATH="/tmp/tesseract"
# Optional: serve eng.traineddata from your own origin instead of the CDN.
# TESSERACT_LANG_PATH=""

# ============== ZERO-STORAGE RETENTION (RA 10173) ==============
# Medical documents are never persisted. Chat turns quote the patient's
# document, so they are purged on the cleanup trigger once older than this.
# Default: 24 hours.
CHAT_MESSAGE_TTL_MS="86400000"

# ============== APP CONFIGURATION (RECOMMENDED) ==============
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============== DEV ONLY ==============
# Set to true only if you want to bypass env validation locally.
# Do NOT use this on Vercel.
# SKIP_ENV_VALIDATION="true"
