{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--viewport-size",
        "1280,900",
        "--save-trace",
        "--output-dir",
        "./.playwright-mcp"
      ],
      "env": {
        "PLAYWRIGHT_MCP_BASE_URL": "http://localhost:3100"
      }
    }
  }
}
