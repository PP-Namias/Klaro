{
  "name": "@klaro/nextjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "dev:no-env": "cross-env SKIP_ENV_VALIDATION=true next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@klaro/api": "workspace:*",
    "@klaro/auth": "workspace:*",
    "@klaro/db": "workspace:*",
    "@klaro/ui": "workspace:*",
    "@klaro/validators": "workspace:*",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "cloudinary": "catalog:",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "^16.0.9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-leaflet": "^5.0.0",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@klaro/eslint-config": "workspace:*",
    "@klaro/prettier-config": "workspace:*",
    "@klaro/tailwind-config": "workspace:*",
    "@klaro/tsconfig": "workspace:*",
    "@types/leaflet": "^1.9.21",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "cross-env": "^10.1.0",
    "eslint": "catalog:",
    "jiti": "^2.6.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  },
  "prettier": "@klaro/prettier-config"
}
