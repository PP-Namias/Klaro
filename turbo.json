{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  },
  "globalEnv": [
    "POSTGRES_URL",
    "AUTH_DISCORD_ID",
    "AUTH_DISCORD_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_REDIRECT_PROXY_URL",
    "AUTH_SECRET",
    "AWS_BEDROCK_REGION",
    "PORT",
    "ADMIN_EMAILS",
    "AI_SIDECAR_URL",
    "ANTHROPIC_API_KEY",
    "CAL_COM_API_KEY",
    "CAL_COM_BASE_URL",
    "CAL_COM_EVENT_TYPE_ID",
    "CAL_COM_USERNAME",
    "CHAT_MESSAGE_TTL_MS",
    "CHAT_MODEL_FALLBACK",
    "CHUNK_SIZE",
    "CLEANUP_BATCH_SIZE",
    "CLEANUP_DRY_RUN",
    "CORS_ORIGINS",
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_API_SECRET",
    "CLOUDINARY_CLOUD_NAME",
    "CLOUDINARY_UPLOAD_PRESET",
    "EMBEDDING_MODEL",
    "EMBEDDING_PROVIDER",
    "ENCRYPTION_KEY_VERSION",
    "ENCRYPTION_MASTER_KEY",
    "FILE_MAX_RETENTION_HOURS",
    "FILE_RETENTION_HOURS",
    "FIREWORKS_API_KEY",
    "GEMINI_API_KEY",
    "GEMINI_FALLBACK_ENABLED",
    "GEMINI_LOG_FALLBACK",
    "GEMINI_MOCK_DELAY",
    "GEMINI_MODEL",
    "GEMINI_SCAN_API_URL",
    "GOOGLE_API_KEY",
    "GOOGLE_GENAI_API_KEY",
    "GOOGLE_VISION_API_KEY",
    "GROQ_API_KEY",
    "LLM_API_KEY",
    "LLM_MODEL",
    "LLM_PROVIDER",
    "MEDICAL_GUARDRAIL_STRICT",
    "MODEL_MAX_RETRIES",
    "MODEL_TIMEOUT",
    "NEXT_PUBLIC_NEON_AUTH_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "OCR_CONFIDENCE_THRESHOLD",
    "OCR_ENABLED",
    "OLLAMA_BASE_URL",
    "OPENAI_API_KEY",
    "PIPELINE_ENABLE_FALLBACK",
    "PIPELINE_ENABLE_GEMINI",
    "PIPELINE_ENABLE_OCR",
    "PIPELINE_LANGUAGE",
    "SESSION_TIMEOUT_MS",
    "SESSION_WARNING_MS",
    "SKIP_ENV_VALIDATION",
    "TESSERACT_CACHE_PATH",
    "TESSERACT_LANG_PATH",
    "TOGETHER_API_KEY",
    "VECTOR_STORE_PROVIDER",
    "VERCEL_BRANCH_URL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_REGION",
    "VERCEL_URL",
    "K_RETRIEVAL",
    "LLM_TEMPERATURE",
    "MAX_RETRIEVED_DOCS",
    "ENABLE_MOCK_MODE",
    "CHUNK_OVERLAP",
    "CHROMA_DB_URL",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "JWT_SECRET",
    "RATE_LIMIT_WINDOW_MS",
    "RATE_LIMIT_MAX_REQUESTS",
    "LANGCHAIN_TRACING_V2",
    "LANGCHAIN_API_KEY",
    "LANGCHAIN_PROJECT"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event",
    "SKIP_ENV_VALIDATION"
  ]
}
