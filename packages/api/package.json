{
  "name": "@klaro/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-gemini": "node ./test-gemini.mjs",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@klaro/auth": "workspace:*",
    "@klaro/db": "workspace:*",
    "@klaro/validators": "workspace:*",
    "@napi-rs/canvas": "^0.1.65",
    "@trpc/server": "catalog:",
    "cloudinary": "catalog:",
    "drizzle-orm": "^0.44.7",
    "pdfjs-dist": "4.0.379",
    "sharp": "^0.33.5",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@klaro/eslint-config": "workspace:*",
    "@klaro/prettier-config": "workspace:*",
    "@klaro/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "prettier": "@klaro/prettier-config"
}
