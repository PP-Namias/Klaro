# ============================================================================
# Klaro AI Sidecar — Environment Variables Template
# ============================================================================
# Copy this file to `.env` in packages/ai-sidecar/ and populate all values.
# NEVER commit `.env` — it contains secrets and is gitignored.
# ============================================================================

# ============== SERVER ==============
PORT=3002
NODE_ENV=development
CORS_ORIGINS=*

# ============== VECTOR STORE ==============
# Options: chroma | supabase
VECTOR_STORE_PROVIDER=chroma

# ChromaDB
CHROMA_DB_URL=http://localhost:8000
CHROMA_DB_PATH=./chroma_db

# Supabase (alternative — only needed if VECTOR_STORE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============== LLM PROVIDERS ==============
# Primary chat model (format: provider/model — bare provider names like "gemini" are also accepted)
# Supported: openai, anthropic, google-genai, groq, ollama, together, fireworks, bedrock
CHAT_MODEL=openai/gpt-4o

# Fallback model (used when primary returns 429 rate-limit or errors).
# Set to "mock" to return simulated answers when the primary model fails.
CHAT_MODEL_FALLBACK=openai/gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Embedding provider (options: openai, google-genai/gemini). Defaults to LLM_PROVIDER.
EMBEDDING_PROVIDER=openai

# Generation temperature for chat answers (0.0-1.0)
LLM_TEMPERATURE=0.3

# Max documents to retrieve per query
MAX_RETRIEVED_DOCS=5

# Model invoke timeout in milliseconds
MODEL_TIMEOUT=25000

# Max retries for model invokes
MODEL_MAX_RETRIES=3

# Return simulated answers without any API key
ENABLE_MOCK_MODE=false

# API Keys (set only those for providers you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
AWS_BEDROCK_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ollama (local) — no API key needed, set CHAT_MODEL=ollama/llama3
OLLAMA_BASE_URL=http://localhost:11434

# ============== DOCUMENT PROCESSING ==============
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
K_RETRIEVAL=5

# ============== OCR ==============
# Enable OCR for scanned PDFs (image-based, no embedded text)
OCR_ENABLED=true
# Minimum confidence threshold (0.0–1.0) — documents below this are flagged
OCR_CONFIDENCE_THRESHOLD=0.7

# ============== LANGCHAIN TRACING (OPTIONAL) ==============
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=klaro-ai-sidecar
