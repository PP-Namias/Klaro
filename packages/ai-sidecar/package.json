{
  "name": "@klaro/ai-sidecar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Sidecar Microservice — LangChain/LangGraph RAG engine for Klaro HRIS",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "@langchain/community": "^0.3.26",
    "@langchain/core": "^0.3.32",
    "@langchain/langgraph": "^0.2.41",
    "@langchain/openai": "^0.3.17",
    "@langchain/textsplitters": "^0.1.0",
    "@supabase/supabase-js": "^2.48.1",
    "chromadb": "^1.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@klaro/eslint-config": "workspace:*",
    "@klaro/prettier-config": "workspace:*",
    "@klaro/tsconfig": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "prettier": "@klaro/prettier-config"
}
