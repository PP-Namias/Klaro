{
  "name": "@klaro/validators",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./extraction": {
      "types": "./src/extraction.ts",
      "default": "./src/extraction.ts"
    },
    "./llm": {
      "types": "./src/llm.ts",
      "default": "./src/llm.ts"
    },
    "./documents": {
      "types": "./src/documents.ts",
      "default": "./src/documents.ts"
    },
    "./facilities": {
      "types": "./src/facilities.ts",
      "default": "./src/facilities.ts"
    },
    "./scan-analysis": {
      "types": "./src/scan-analysis.ts",
      "default": "./src/scan-analysis.ts"
    }
  },
  "imports": {},
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@klaro/eslint-config": "workspace:*",
    "@klaro/prettier-config": "workspace:*",
    "@klaro/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@klaro/prettier-config"
}
