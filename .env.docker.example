# ============================================================================
# Overrides for the Docker stack.
#
#   cp .env.docker.example .env.docker
#
# Loaded after `docker/defaults.env`, so anything set here wins. Everything is
# commented out on purpose: copying this file as-is changes nothing and the
# stack still comes up. Uncomment only what you actually have a value for —
# an empty string is a value, and it will fail validation for URL fields.
#
# Database wiring and the scan/sidecar service URLs are pinned in
# docker-compose.yml and deliberately cannot be overridden here.
# ============================================================================

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
# AUTH_SECRET=""

# Discord OAuth — https://discord.com/developers/applications
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# Google OAuth (optional)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ---- AI / scanning --------------------------------------------------------
# Leave unset to keep the scan backend returning mocked results.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# MOCK_GEMINI="false"

# ---- Uploads --------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_UPLOAD_PRESET="klaro_uploads"

# ---- Scheduling -----------------------------------------------------------
# CAL_COM_API_KEY=""
# CAL_COM_BASE_URL="https://api.cal.com"
# CAL_COM_WEBHOOK_SECRET=""

# ---- Supabase -------------------------------------------------------------
# NEXT_PUBLIC_* is compiled into the browser bundle, so it is read at BUILD
# time from your shell (or `--env-file`), not from this file at runtime:
#   docker compose --env-file .env.docker build web
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
